# apps/api environment — playbook Section 27.1 (placeholders only)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aptiva:aptiva@localhost:5432/aptiva
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-long-random-value
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
NOTICE_VERSION=2026-11
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=replace
GOOGLE_CLIENT_SECRET=replace
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
EMAIL_API_KEY=replace
EMAIL_FROM=noreply@example.com
S3_ENDPOINT=replace
S3_BUCKET=replace
S3_ACCESS_KEY=replace
S3_SECRET_KEY=replace
SENTRY_DSN=
POSTHOG_KEY=
PLANNER_BUDGET_MS=250
STREAM_BATCH_MAX=100
STREAM_BATCH_MS=1000
FLUSH_BARRIER_TIMEOUT_MS=10000
ATTEMPT_STREAM=aptiva:attempts
ATTEMPT_GROUP=attempt-writers
ATTEMPT_DEADLETTER_STREAM=aptiva:attempts:deadletter
ATTEMPT_CONSUMER_ENABLED=true
ATTEMPT_MIN_IDLE_MS=30000
ENGINE_VERSION=1.0.0
# Multiplies all rate-limit ceilings — leave unset in production; the
# integration suite sets 1000 so fast tests don't trip the auth bucket.
# RATE_LIMIT_FACTOR=
# P1 billing
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
