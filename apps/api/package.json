{
  "name": "@aptiva/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "predev": "pnpm --filter @aptiva/ingest build && pnpm --filter @aptiva/engine build",
    "prebuild": "pnpm --filter @aptiva/ingest build && pnpm --filter @aptiva/engine build",
    "pretest": "pnpm --filter @aptiva/ingest build && pnpm --filter @aptiva/engine build",
    "pretest:integration": "pnpm --filter @aptiva/ingest build && pnpm --filter @aptiva/engine build"
  },
  "dependencies": {
    "@aptiva/engine": "workspace:*",
    "@aptiva/ingest": "workspace:*",
    "@aptiva/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "bullmq": "6.7.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
